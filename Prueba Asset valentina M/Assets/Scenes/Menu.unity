  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "ESCENA 1: Busca la llave escondida lo m\xE1s r\xE1pido posible, deberas
    escapar del zombie o reiniciar\xE1s la escena.\n\nESCENA 2: Resuelve el acertijo
    a tiempo en el menor timepo posible, de lo contrario atienete a las consecuencias.\n\nESCENA
    3: Recolecta corazones que seran tus vidas  y la espada para enfrentarte con
    el enemigo. Cuidado con perderte y con las estatuas.\n\nESCENA 4: Usa la espada
    para pelear contra el zombie. Cada golpe que recibas te quita corazones. Derrotalo
    y lograras salir de la manci\xF3n Z.\n\n\n"
  m_isRightToLeft: 0
